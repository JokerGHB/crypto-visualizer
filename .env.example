APP_NAME=密码学算法可视化教学与 AI 辅导平台
DEBUG=true

# 开发默认 SQLite；生产改为 mysql+pymysql://user:pass@host:3306/dbname
DATABASE_URL=sqlite:///./crypto_visualizer.db

# 认证：生产必须替换为随机长字符串（openssl rand -hex 32）
JWT_SECRET=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 允许的前端来源，逗号分隔。生产改为实际域名
# 前端开发端口见 frontend/vite.config.ts（当前 5200）
CORS_ORIGINS=http://localhost:5200,http://127.0.0.1:5200

# AI 服务（OpenAI 兼容协议）
# 密钥推荐用环境变量 GPT_API_KEY 注入，不写入本文件（见 docs/deploy.md）
# 也兼容 AI_API_KEY / OPENAI_API_KEY 两个旧名称，优先级依次降低
AI_ENABLED=true
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 实测该端点首字节延迟 10~45 秒波动，超时设太小会稳定降级
AI_TIMEOUT=90
AI_RATE_LIMIT_PER_MINUTE=20